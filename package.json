{
  "name": "botcheckerminecraft",
  "version": "0.2.0",
  "private": true,
  "description": "Minecraft new-player journey and GUI tester",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:java && npm run build:paper-adapter && node -e \"import('./dist/src/runner.js')\"",
    "build:java": "node scripts/build-java.mjs",
    "build:paper-adapter": "node scripts/build-paper-adapter.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 test/**/*.test.ts",
    "verify:coverage-floor": "node scripts/verify-test-coverage-floor.mjs",
    "verify:paper-forward-compat": "node scripts/verify-paper-forward-compat.mjs",
    "verify:kms-hsm": "npm run build --silent && node scripts/verify-google-cloud-kms-hsm.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@google-cloud/kms": "6.0.0",
    "fast-crc32c": "2.0.0",
    "fastify": "5.11.3",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "0.1.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/fast-crc32c": "2.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}

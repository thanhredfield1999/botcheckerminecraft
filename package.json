{
  "name": "botcheckerminecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft new-player journey and GUI tester",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('./dist/src/runner.js')\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastify": "5.11.3",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "0.1.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
